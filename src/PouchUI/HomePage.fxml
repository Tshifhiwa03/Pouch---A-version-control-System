<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="root" stylesheets="@homepage.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="PouchUI.HomePageController">

    <!-- Top: Project Selector -->
    <top>
        <HBox spacing="10" styleClass="top-bar">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label text="Select Project:" />
            <ComboBox fx:id="projectsComboBox" prefWidth="200" />
            <Button onAction="#handleNewProjectButton" text="New Project" />
            <Button onAction="#handleOpenRepo" text="Open Repo" />
        </HBox>
    </top>

    <!-- Left: File Browser -->
    <left>
        <VBox spacing="8" styleClass="left-panel">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label styleClass="panel-title" text="Project Files" />
            <ListView fx:id="fileListView" prefWidth="250" />
        </VBox>
    </left>

    <!-- Center: Commit Panel + History -->
    <center>
        <VBox spacing="15" styleClass="center-panel">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label fx:id="centerTitleLabel" styleClass="panel-title" text="Select a project">
            <font>
               <Font size="20.0" />
            </font></Label>
            <Label fx:id="centerSubtitleLabel" styleClass="panel-subtitle" text="" />

            <HBox spacing="20">
                <!-- Left side: Commit panel -->
                <VBox spacing="10" styleClass="commit-panel" HBox.hgrow="ALWAYS">

                    <Label styleClass="section-header" text="Select files to commit:" />
                    <!-- 🔹 New file selection list -->
                    <ListView fx:id="fileSelectionListView" prefHeight="200" styleClass="file-selection-list" />

                    <Label text="Commit Title:" />
                    <TextField fx:id="commitTitleField" promptText="Enter commit title..." />

                    <Label text="Commit Description:" />
                    <TextArea fx:id="commitDescriptionField" prefRowCount="5" promptText="Describe your changes..." />

                    <Button onAction="#handleCommit" styleClass="action-button" text="Commit Changes" />
                </VBox>

                <!-- Right side: History panel -->
                <VBox spacing="10" styleClass="history-panel" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-header" text="Commit History" />
                    <ListView fx:id="historyListView" prefHeight="300" />
                    <HBox spacing="8">
                        <Button onAction="#handleViewHistory" text="View History" />
                        <Button onAction="#handleRollback" text="Rollback" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- Right: Placeholder -->
    <right>
        <VBox spacing="8" styleClass="right-panel">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Label styleClass="panel-title" text="Right Panel (future content)" />
        </VBox>
    </right>
</BorderPane>
